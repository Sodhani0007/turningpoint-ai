# TurningPoint AI Environment Variables

# Backend API Port (Default: 8000)
PORT=8000

# Optional: Groq or OpenAI compatible API Key for live AI momentum explanations
# If omitted, the engine uses verified precomputed momentum analysis
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Frontend API URL (leave empty for relative /api proxy)
VITE_API_URL=
